# Copy this file to .env.local and fill in the value.
# .env.local is gitignored and stays on your machine only.
#
# Your FREE Google AI Studio API key (server-side only, never exposed to the
# browser). Get one at https://aistudio.google.com/apikey — free, no credit card.
# The app reaches Gemini through its OpenAI-compatible endpoint; the free tier
# means the whole app runs at zero cost.
GEMINI_API_KEY=

# Optional model overrides. Both tiers default to gemini-3.8-flash. Leave blank
# to use the defaults; set a different Gemini model id here to swap without
# touching code.
GEMINI_MODEL=
GEMINI_MODEL_CHEAP=

# Mock mode — set to 1 to run WITHOUT any key and WITHOUT any cost. The seams
# return canned fixtures, but the whole real path still runs (routes, validation,
# telemetry, graph assembly, client render), so you can click through the app and
# see the loading animations for free. If no GEMINI_API_KEY is set, the app falls
# back to mock automatically — it never makes a real call by accident. Restart the
# dev server after changing this — Next reads env only at startup.
LLM_MOCK=
