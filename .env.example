# Copy this file to .env.local and fill in the value.
# .env.local is gitignored and stays on your machine only.
#
# Your Anthropic API key (server-side only, never exposed to the browser).
# Get one at https://console.anthropic.com/ -> API Keys.
ANTHROPIC_API_KEY=

# Only needed if your key is "identity-linked" (the API returns a 400 asking
# for it). Find the workspace id in the console. A plain workspace-scoped key
# does not need this — leave it blank.
ANTHROPIC_WORKSPACE_ID=

# Mock mode — set to 1 to run WITHOUT a real API key and WITHOUT any cost.
# The seams return canned fixtures, but the whole real path still runs (routes,
# validation, telemetry, graph assembly, client render), so you can click
# through the app and see the loading animations for free. Leave blank / unset
# to make real calls (needs ANTHROPIC_API_KEY above). Restart the dev server
# after changing this — Next reads env only at startup.
LLM_MOCK=
